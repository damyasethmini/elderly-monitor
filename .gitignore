# Python environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Model weights - downloaded automatically by Ultralytics
*.pt
*.onnx
*.engine

# Raw videos - large files, not required in Git
data/videos/*.mp4
data/videos/*.avi
data/videos/*.mov
data/videos/*.mkv

# Large generated frame outputs
results/**/frames/
results/**/pose/annotated/
results/**/pose/observations/

# Temporary/log files
*.log
*.tmp